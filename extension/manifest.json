{
  "manifest_version": 3,
  "name": "OfficeMini",
  "version": "0.3.8",
  "description": "Open .docx and .xlsx links in an editor in the browser instead of downloading them.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "OfficeMini",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "110"
}
